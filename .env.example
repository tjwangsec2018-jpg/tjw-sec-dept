# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Firebase Cloud Messaging (FCM) Push Relay Configuration:
# Public Web Push VAPID key from Firebase Console -> Project Settings -> Cloud Messaging
VITE_FIREBASE_VAPID_KEY=""

# Optional server-side FCM key for direct mobile push relay
FCM_SERVER_KEY=""
